{
  "name": "commitly-server",
  "version": "1.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/db/run-drizzle-migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.5.0",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@commitly/schemas": "file:../schemas",
    "drizzle-orm": "^0.44.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "postgres": "^3.4.8"
  }
}